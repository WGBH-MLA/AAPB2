<dd class="contributors">
  <dl>
    <% @pbcore.all_parties.each do |party| %>
      <% if party.role %>
        <b><%= party.role %>:</b>
      <% end %>
      <%= party.name %>
      <% if party.role_annotation %>
        (<%= party.role_annotation %>)
      <% end %>
      <br>
    <% end %>
  </dl>
</dd>
